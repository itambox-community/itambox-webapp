msgid "Returned after repair maintenance %(maintenance)s completed."
msgstr "Nach Abschluss der Reparatur-Wartung %(maintenance)s zurückgenommen."

#: itambox/itambox/assets/services/__init__.py
msgid "Start the disposal of the unit that was under repair"
msgstr "Entsorgung des reparierten Geräts starten"

#: itambox/itambox/assets/services/__init__.py
msgid "The asset has no holder, so no loaner can be issued."
msgstr "Das Asset hat keinen Nutzer, daher kann kein Leihgerät ausgegeben werden."

#: itambox/itambox/assets/services/__init__.py
msgid "The loaner must belong to the same tenant as the asset."
msgstr "Das Leihgerät muss zum selben Mandanten gehören wie das Asset."

#: itambox/itambox/assets/services/__init__.py
msgid "The maintenance must belong to the same tenant as the asset."
msgstr "Die Wartung muss zum selben Mandanten gehören wie das Asset."

#: itambox/itambox/assets/services/__init__.py
msgid "The unit under repair cannot be issued to itself as a loaner."
msgstr "Das reparierte Gerät kann nicht als Leihgerät an sich selbst ausgegeben werden."

#: itambox/itambox/assets/services/__init__.py
msgid "There is no open loaner to close."
msgstr "Es gibt kein offenes Leihgerät zum Abschließen."

#: itambox/itambox/assets/services/__init__.py
msgid "This repair has no open loaner."
msgstr "Diese Reparatur hat kein offenes Leihgerät."

#: itambox/itambox/assets/services/__init__.py
msgid "Unknown repair completion action."
msgstr "Unbekannte Abschluss-Aktion für die Reparatur."

#: itambox/itambox/assets/services/__init__.py
msgid "You are not allowed to dispose of an asset."
msgstr "Sie dürfen kein Asset entsorgen."

