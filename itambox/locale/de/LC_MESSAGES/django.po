msgstr "Nur eine Reparatur-Wartung kann eine Reparatur abschließen."

#: itambox/itambox/assets/services/__init__.py
msgid "Optional: the repair maintenance this disposal closes out."
msgstr "Optional: die Reparatur-Wartung, die diese Entsorgung abschließt."

#: itambox/itambox/assets/services/__init__.py
msgid "Optional: the repair maintenance this loan or handover belongs to."
msgstr "Optional: die Reparatur-Wartung, zu der diese Leihe oder Übergabe gehört."

#: itambox/itambox/assets/services/__init__.py
msgid "Repair Maintenance"
msgstr "Reparatur-Wartung"

#: itambox/itambox/assets/services/__init__.py
msgid "Replace permanently - the loaner stays with the holder"
msgstr "Dauerhaft ersetzen - Leihgerät bleibt beim Nutzer"

#: itambox/itambox/assets/services/__init__.py
msgid "Returned %(date)s"
msgstr "Zurückgegeben am %(date)s"

