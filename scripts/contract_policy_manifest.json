  "required_statements": [
    {
      "document": "policy",
      "identifier": "P-API-V1",
      "text": "`/api/` is the version 1 compatibility convention for the whole of 1.x"
    },
    {
      "document": "policy",
      "identifier": "P-API-NO-SEAM",
      "text": "no version segment, no negotiation header, and no runtime version seam"
    },
    {
      "document": "policy",
      "identifier": "P-API-V2",
      "text": "would have to be mounted separately as `/api/v2/`"
    },
    {
      "document": "policy",
      "identifier": "P-STABLE-ADDITIVE",
      "text": "additive-only for the whole of 1.x"
    },
    {
      "document": "policy",
      "identifier": "P-STABLE-FROZEN",
      "text": "names, types, closed enum values, primary-key URLs"
    },
    {
      "document": "policy",
      "identifier": "P-STABLE-NOTICE",
      "text": "two minor releases of removal notice"
    },
    {
      "document": "policy",
      "identifier": "P-STABLE-PATCH",
      "text": "never removed in a patch release"
    },
    {
      "document": "policy",
      "identifier": "P-STABLE-NO-WEAKENING",
      "text": "cannot be weakened within 1.x"
    },
    {
      "document": "policy",
      "identifier": "P-STABLE-ROLLBACK",
      "text": "S5 realistic rollback"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-ENABLED-LABELLING",
      "text": "a release obligation on Beta enabled work, not a claim that every surface already carries it"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-ENABLED-DATA",
      "text": "preserves the data an operator already recorded"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-ENABLED-MINOR",
      "text": "only in a minor release, never in a patch"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-ENABLED-NOTICE",
      "text": "one minor release of notice and an export"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-ENABLED-INACTIVE",
      "text": "a real inactive state"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-OPT-IN-INERT",
      "text": "inert on a fresh deployment"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-OPT-IN-ACTIVATION",
      "text": "activation surface itself is held to the Stable standard"
    },
    {
      "document": "policy",
      "identifier": "P-BETA-OPT-IN-WIRE",
      "text": "must carry its own independent wire version"
    },
    {
      "document": "policy",
      "identifier": "P-WIRE-V1",
      "text": "carries an explicit `schema_version`, `event_id`, `delivery_id`, `attempt`, `tenant`, `event`, `model`, `object_id`, `timestamp`, and `data` field"
    },
    {
      "document": "policy",
      "identifier": "P-WIRE-NOT-CONTRACT-VERSION",
      "text": "`contract_version` versions the registry declaration"
    },
    {
      "document": "policy",
      "identifier": "P-EXPERIMENTAL-OPT-IN",
      "text": "reached only through an explicit configuration opt-in"
    },
    {
      "document": "policy",
      "identifier": "P-EXPERIMENTAL-CHANGE",
      "text": "may change in any release, including a patch"
    },
    {
      "document": "policy",
      "identifier": "P-EXPERIMENTAL-SUPPORT",
      "text": "security fixes only"
    },
    {
      "document": "policy",
      "identifier": "P-EXPERIMENTAL-PINNING",
      "text": "pin the exact revision"
    },
    {
      "document": "policy",
      "identifier": "P-SAFETY-FLOOR",
      "text": "N1-N11 and X1-X6 safety floors"
    },
    {
      "document": "policy",
      "identifier": "P-SECURITY-CRITICAL",
      "text": "security-critical marker"
    },
    {
      "document": "policy",
      "identifier": "P-TENANT-ISOLATION",
      "text": "tenant B cannot read, write, list, filter, export, or reference"
    },
    {
      "document": "policy",
      "identifier": "P-SERVICE-LAYER-PARITY",
      "text": "service and data layers enforce the same authorization"
    },
    {
      "document": "policy",
      "identifier": "P-SCHEDULED-NINE",
      "text": "nine `ScheduledReport` frequency values"
    },
    {
      "document": "policy",
      "identifier": "P-CONFIG-RENAME",
      "text": "compatibility read and a startup warning"
    },
    {
      "document": "policy",
      "identifier": "P-N9-OBSERVABILITY",
      "text": "N9 and S6"
    },
    {
      "document": "policy",
      "identifier": "P-N9-DEPLOYMENT",
      "text": "no in-product actor"
    },
    {
      "document": "policy",
      "identifier": "P-N9-SYNTHETIC",
      "text": "synthetic request identifier and a `None` user"
    },
    {
      "document": "policy",
      "identifier": "P-N9-NEVER-HUMAN",
      "text": "never presented as a human action"
    },
    {
      "document": "policy",
      "identifier": "P-IDEMPOTENCY",
      "text": "idempotency, retry, and durable-outcome"
    },
    {
      "document": "policy",
      "identifier": "P-X2-X4-OBLIGATION",
      "text": "X2-X4 are obligations on capability work, not claims about today"
    },
    {
      "document": "policy",
      "identifier": "P-N11-REHEARSAL",
      "text": "N11 reverse-or-export rehearsal"
    },
    {
      "document": "policy",
      "identifier": "P-DEFERRED-SUBSCRIPTION",
      "text": "`vendor_contract_auto_renews`"
    },
    {
      "document": "policy",
      "identifier": "P-DEFERRED-SUBSCRIPTION-2",
      "text": "removed no earlier than 2.0"
    },
    {
      "document": "policy",
      "identifier": "P-DEFERRED-REQUISITION",
      "text": "`REQUISITION_AUTO_APPROVAL_THRESHOLDS`"
    },
    {
      "document": "policy",
      "identifier": "P-DEFERRED-SCIM",
      "text": "integer-keyed SCIM detail routes remain supported for the whole of 1.x"
    },
    {
      "document": "policy",
      "identifier": "P-RESOURCE-GRANT",
      "text": "no baseline escape"
    },
    {
      "document": "policy",
      "identifier": "P-RESOURCE-GRANT-REVIEW",
      "text": "adversarial review"
    },
    {
      "document": "policy",
      "identifier": "P-RESOURCE-GRANT-THREAT",
      "text": "threat-model duty"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-DENY",
      "text": "Failure of any condition denies access. A grant authorizes a tenant, never a user."
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-ACTORLESS",
      "text": "a bare `user=None` is denied"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-CANONICAL",
      "text": "`organization.access.resolve_stock_access()` is the decision primitive"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-CANONICAL-REEXPORT",
      "text": "`organization.services.resolve_stock_access` is its compatibility re-export"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-PRECEDENCE",
      "text": "Direct tenant grants take deterministic precedence over ancestor-group grants."
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-MATRIX",
      "text": "inventory/tests/test_tenant_resource_grant_security.py"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-DIRECT-WRITES",
      "text": "inventory/tests/test_direct_assignment_writes.py"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-SYSTEM-PROVENANCE-SUITE",
      "text": "inventory/tests/test_assignment_system_authorization_provenance.py"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-ALLOWLIST-CLOSED",
      "text": "The approved resource allowlist is closed:"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-ACCESSORY-STOCK",
      "text": "`inventory.AccessoryStock`"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-COMPONENT-STOCK",
      "text": "`inventory.ComponentStock`"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-CONSUMABLE-STOCK",
      "text": "`inventory.ConsumableStock`"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-PERSISTED-DERIVATION",
      "text": "caller-held relation caches never define `source_tenant`, `target_tenant`, or the covering grant."
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-INDEPENDENT-RBAC",
      "text": "must independently pass RBAC in the active tenant."
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-TOPOLOGY-FAIL-CLOSED",
      "text": "live-only ancestry walk; no coverage through the broken chain"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-UNSCOPED-MANAGER",
      "text": "`TenantResourceGrant.objects` is deliberately unscoped"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-SYSTEM-PROVENANCE",
      "text": "Actorless assignments persist the exact authorized system operation and reason."
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-IMMUTABLE-PROVENANCE",
      "text": "Those values are immutable historical evidence"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-CONTAINER-VISIBILITY",
      "text": "`visible_to_containers()` or fail closed"
    },
    {
      "document": "resource-grant",
      "identifier": "P-RESOURCE-GRANT-LIFECYCLE-ATTRIBUTION",
      "text": "Future grant expiry or revocation workflows must preserve durable attribution"
    },
    {
      "document": "policy",
      "identifier": "P-SCOPE-EXCLUSIONS",
      "text": "What this policy deliberately does not cover"
    },
    {
      "document": "policy",
      "identifier": "P-URL-BOUNDARY",
      "text": "individual UI route names are not frozen"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-BOUNDED",
      "text": "bounded inventory"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-ENUM-OPENNESS",
      "text": "every inventoried enum is marked explicitly open or closed"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-SIGNATURE",
      "text": "X-Hub-Signature-256"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-ROLE-FIELD",
      "text": "`organization.Role.permissions`"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-ROLE-CONCEPT",
      "text": "Tenant Role is the user-facing name"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-API-VERSION",
      "text": "unversioned `/api/` prefix is the version 1 convention"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-URL-BOUNDARY",
      "text": "namespaces are inventoried; individual route names are not"
    },
    {
      "document": "inventory",
      "identifier": "P-INVENTORY-EXCLUSIONS-PINNED",
      "text": "records the exact declared limitation text each cell was written against"
    }
  ],
