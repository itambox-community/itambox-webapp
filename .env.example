# ==============================================================================
# ITAMbox environment variables — template
# ==============================================================================
# Copy to '.env' and edit. Real env vars always win over values in this file.
#
# The settings loader fails closed: if neither ITAMBOX_ENV nor ITAMBOX_DEBUG is
# set, the app runs in PRODUCTION mode. For local development set ITAMBOX_ENV=dev
# (or ITAMBOX_DEBUG=True) below.
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment selection
# ------------------------------------------------------------------------------
# dev | prod. Leave unset to fail closed to prod.
ITAMBOX_ENV=dev
# Enable Django debug mode. NEVER True in production.
ITAMBOX_DEBUG=True

# ------------------------------------------------------------------------------
# Public base URL  (recommended in production)
# ------------------------------------------------------------------------------
# Used to build absolute URLs in QR code labels and outbound links.
# Must NOT have a trailing slash. Leave blank in dev (bare-tag QR codes work
# without it; the app uses the itambox:<tag> scheme by default).
# ITAMBOX_BASE_URL=https://itam.example.com

# ------------------------------------------------------------------------------
# Core / security  (required in production)
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production rejects keys shorter than 50 characters, keys with fewer than 5
# distinct characters, and anything starting with 'django-insecure-'.
ITAMBOX_SECRET_KEY=

# *** CRITICAL — field-encryption keyring (set this in production!) ***
# Fernet key(s) that encrypt sensitive stored values (License.product_key,
# SMTP password, webhook secrets). Comma-separated; the FIRST key encrypts,
# ALL keys decrypt — append the old key when rotating.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# When UNSET or blank, the key is derived from ITAMBOX_SECRET_KEY as a dev
# convenience — then rotating SECRET_KEY makes every encrypted field
# PERMANENTLY unreadable. An explicitly supplied NON-BLANK value that is not a
# valid keyring (including only whitespace/separators) ABORTS production
# startup — malformed configuration never silently falls back. Set a dedicated
# value in production and back it up together with every database dump — they
# are a unit.
ITAMBOX_FIELD_ENCRYPTION_KEYS=

# Server-side peppers used to HMAC-hash API tokens at rest. This MUST be a JSON
# object whose numeric keys are rotation IDs and whose values are dedicated
# secrets of at least 50 characters. The highest ID peppers new tokens; older
# IDs keep existing tokens valid. Example:
#   {"1":"replace-with-a-random-secret-of-at-least-50-characters"}
# When UNSET or blank, token hashing falls back to a SECRET_KEY-derived pepper
# (acceptable for development; production starts with a loud warning). An
# explicitly supplied NON-BLANK value that is not a valid mapping ABORTS
# production startup — malformed configuration never silently falls back.
# Tokens hashed under the fallback stop validating once a dedicated mapping is
# configured: re-issue them after the cutover.
ITAMBOX_API_TOKEN_PEPPERS=

# Comma-separated hosts the site may serve. Keep 127.0.0.1 so the container
# health probe works.
ITAMBOX_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins trusted for cross-origin POST/PUT (scheme required), e.g.
# https://itam.example.com
ITAMBOX_CSRF_TRUSTED_ORIGINS=

# HTTPS hardening (only applied in prod). Leave SSL redirect on unless TLS is
# terminated upstream and you handle redirects there.
ITAMBOX_SECURE_SSL_REDIRECT=True
ITAMBOX_HSTS_SECONDS=31536000
ITAMBOX_HSTS_INCLUDE_SUBDOMAINS=True
ITAMBOX_HSTS_PRELOAD=True

# Logging level: DEBUG | INFO | WARNING | ERROR
ITAMBOX_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database (PostgreSQL 15+ required)
# ------------------------------------------------------------------------------
ITAMBOX_DB_ENGINE=django.db.backends.postgresql
ITAMBOX_DB_NAME=itambox
ITAMBOX_DB_USER=itambox
# Leave empty here. Local development (ITAMBOX_ENV=dev) applies an internal
# convenience default; production REQUIRES an explicitly configured password —
# the bundled Compose stack aborts before any container starts without one
# (blank counts as missing). Set the value IN THIS FILE: a shell-exported
# ITAMBOX_DB_PASSWORD is shadowed by this blank line inside the compose
# app/worker containers.
ITAMBOX_DB_PASSWORD=
ITAMBOX_DB_HOST=localhost
ITAMBOX_DB_PORT=5432
ITAMBOX_DB_CONN_MAX_AGE=300
# prefer | require | verify-full  (use require/verify-full for managed/remote PG)
ITAMBOX_DB_SSLMODE=prefer

# ------------------------------------------------------------------------------
# Cache / rate limiting
# ------------------------------------------------------------------------------
# locmem | redis. Use a Redis-protocol server in production (Valkey recommended —
# BSD-licensed fork of Redis) so throttles + rate-limit counters are shared
# across gunicorn workers.
ITAMBOX_CACHE_BACKEND=locmem
ITAMBOX_REDIS_URL=redis://127.0.0.1:6379/1
ITAMBOX_CACHE_TIMEOUT=300
# Cache alias used for the login/invite rate limiter (point at redis in prod).
RATELIMIT_CACHE=default
# Only enable these when every request reaches the app through a trusted proxy
# that overwrites/appends X-Forwarded-For (for example, Cloudflare Tunnel).
# Direct-origin deployments must keep the default disabled to reject spoofed
# forwarding headers. Set the hop count to the number of trusted proxies.
# ITAMBOX_RATELIMIT_USE_X_FORWARDED_FOR=False
# ITAMBOX_RATELIMIT_NUM_PROXIES=1

# ------------------------------------------------------------------------------
# Email (used in prod; dev uses a local SMTP catcher automatically)
# ------------------------------------------------------------------------------
ITAMBOX_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
ITAMBOX_EMAIL_HOST=localhost
ITAMBOX_EMAIL_PORT=587
ITAMBOX_EMAIL_HOST_USER=
ITAMBOX_EMAIL_HOST_PASSWORD=
ITAMBOX_EMAIL_USE_TLS=True
ITAMBOX_EMAIL_USE_SSL=False
ITAMBOX_DEFAULT_FROM_EMAIL="ITAMbox <no-reply@example.com>"
# From-address for server error mails (defaults to DEFAULT_FROM_EMAIL).
# ITAMBOX_SERVER_EMAIL=noreply@itam.example.com
# Outbound SMTP timeout in seconds (bounds web requests/tasks against a dead
# mail server; Django's own default would be no timeout at all).
ITAMBOX_EMAIL_TIMEOUT=10

# ------------------------------------------------------------------------------
# Application behavior (optional)
# ------------------------------------------------------------------------------
# ISO 4217 fallback for money display; each tenant can override its own currency.
ITAMBOX_DEFAULT_CURRENCY=EUR
# Upper bound for the list-page row counter (exact below the cap, "<cap>+" above;
# 0 = unbounded COUNT(*) on every list view — slow at large scale).
ITAMBOX_PAGINATOR_COUNT_CAP=100000
# Interactive session lifetime in seconds.
# ITAMBOX_SESSION_COOKIE_AGE=1209600
# Filesystem path to the compiled MkDocs output (defaults to BASE_DIR/docs).
# ITAMBOX_DOCS_ROOT=/app/docs
# Enforce TOTP MFA for local-password logins by superusers/owner-admin roles
# (SSO/LDAP/SAML/OIDC always delegate MFA to the IdP). Default: True in prod.
# ITAMBOX_REQUIRE_MFA=True

# Opt-in auto-approval for low-risk asset requests. JSON object; supported keys
# are 'accessory' and 'consumable', each a non-negative integer quantity.
# Unset = no auto-approval (requests stay pending). Invalid JSON, unknown keys,
# or non-integer/bool values abort startup. Legacy name
# REQUISITION_AUTO_APPROVAL_THRESHOLDS is accepted through 1.x with a warning.
# ITAMBOX_REQUISITION_AUTO_APPROVAL_THRESHOLDS={"accessory": 3, "consumable": 5}

# ------------------------------------------------------------------------------
# Compliance (optional)
# ------------------------------------------------------------------------------
# Require a digital signature on custody receipt sign-off.
ITAMBOX_REQUIRE_CUSTODY_SIGNIN=True
# Allow custody templates that are not scoped to a tenant.
ITAMBOX_ALLOW_GLOBAL_CUSTODY_TEMPLATES=True

# ------------------------------------------------------------------------------
# Data retention (0 = keep forever; see docs/operations/data-retention.md)
# ------------------------------------------------------------------------------
# Pruned daily by the scheduled prune_changelog task (or run it via cron).
# Per-tenant changelog overrides/legal holds: Tenant.changelog_retention_days.
ITAMBOX_CHANGELOG_RETENTION_DAYS=365
ITAMBOX_ALERTLOG_RETENTION_DAYS=180
ITAMBOX_NOTIFICATION_RETENTION_DAYS=90
# Event-stream retention. Default 0 = retained indefinitely; pruning starts
# only when a positive value is configured (prune_changelog --classes event).
ITAMBOX_EVENT_RETENTION_DAYS=0
ITAMBOX_QTASK_FAILED_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# Operational health thresholds (manage.py operational_health)
# ------------------------------------------------------------------------------
ITAMBOX_HEALTH_SCHEDULE_GRACE_SECONDS=900
ITAMBOX_HEALTH_QUEUE_BACKLOG_MAX=1000
ITAMBOX_HEALTH_QUEUE_AGE_SECONDS=1800
ITAMBOX_HEALTH_JOB_STUCK_SECONDS=3600
ITAMBOX_HEALTH_FAILURES_24H_MAX=10

# ------------------------------------------------------------------------------
# Static / media paths (optional overrides)
# ------------------------------------------------------------------------------
# ITAMBOX_STATIC_ROOT=/app/staticfiles
# ITAMBOX_MEDIA_ROOT=/app/media

# ------------------------------------------------------------------------------
# Plugins (optional)
# ------------------------------------------------------------------------------
# Comma-separated importable plugin packages. Each must be installed.
# ITAMBOX_PLUGINS=example_plugin
# Plugin settings: JSON keyed by package, validated against the plugin's settings_schema.
# ITAMBOX_PLUGINS_CONFIG={"example_plugin": {"endpoint": "https://example.test"}}
# Single values (secrets) override the JSON: ITAMBOX_PLUGIN_<NAME>_<KEY>
# ITAMBOX_PLUGIN_EXAMPLE_PLUGIN_API_KEY=

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
ITAMBOX_CORS_ALLOW_ALL_ORIGINS=False
ITAMBOX_CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Multi-Tenant LDAP / SAML / OIDC SSO  (JSON keyed by tenant slug)
# ------------------------------------------------------------------------------
# ITAMBOX_TENANT_LDAP_CONFIGS='{"tenant-alpha": {"SERVER_URI": "ldap://ldap.alpha-corp.com", "BIND_DN": "cn=admin,dc=alpha-corp,dc=com", "BIND_PASSWORD": "secretpassword", "USER_SEARCH_BASE": "ou=users,dc=alpha-corp,dc=com", "USER_SEARCH_FILTER": "(uid=%(user)s)", "REQUIRE_GROUP": "cn=itambox-users,ou=groups,dc=alpha-corp,dc=com"}}'
# ITAMBOX_TENANT_SAML_CONFIGS='{"tenant-alpha": {"entityid": "https://alpha.itambox.com/saml2/metadata/", "metadata": {"remote": [{"url": "https://identity.alpha-corp.com/federation/metadata"}]}}}'
# ITAMBOX_TENANT_OIDC_CONFIGS='{"tenant-alpha": {"OIDC_RP_CLIENT_ID": "...", "OIDC_RP_CLIENT_SECRET": "...", "OIDC_OP_AUTHORIZATION_ENDPOINT": "https://idp/authorize", "OIDC_OP_TOKEN_ENDPOINT": "https://idp/token", "OIDC_OP_USER_ENDPOINT": "https://idp/userinfo", "OIDC_OP_ISSUER": "https://idp/", "OIDC_OP_JWKS_ENDPOINT": "https://idp/jwks"}}'
# Per-tenant Microsoft Intune device discovery (JSON keyed by tenant slug).
# ITAMBOX_TENANT_INTUNE_CONFIGS='{"tenant-alpha": {"TENANT_ID": "...", "CLIENT_ID": "...", "CLIENT_SECRET": "..."}}'

